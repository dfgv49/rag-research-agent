# ============================================================
# RAG Research Agent - 阿里云百炼版环境变量模板
# 使用方法：复制此文件为 .env，然后填入真实的 API Key
#   Copy-Item .env.example .env
# 注意：.env 已在 .gitignore 中，不会被提交到 Git
# ============================================================

# ---------- 阿里云百炼（对话模型 + 向量模型，统一一家） ----------
# API Key 获取：https://bailian.console.aliyun.com/  ->  API-KEY 管理
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# 兼容 OpenAI 接口的地址。
# 通用域名（推荐先用这个，开箱即用）：
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 业务空间专属域名（官方推荐，性能更稳），拿到 WorkspaceId 后可换成：
# DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ---------- 向量库：本地 Docker Elasticsearch ----------
# 注意：必须用 127.0.0.1，而不是 README 里的 host.docker.internal
# （那个地址只在 LangGraph Studio 也跑在容器里时才正确）
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme

# ---------- 可选：切换到托管向量库时启用 ----------
# Pinecone（建索引时维度必须填 1024，与 text-embedding-v4 对齐）
# PINECONE_API_KEY=...
# PINECONE_INDEX_NAME=...
#
# MongoDB Atlas（索引维度同样填 1024）
# MONGODB_URI=...

# ---------- 可选：LangSmith 链路追踪 ----------
# LANGSMITH_PROJECT=rag-research-agent
# LANGSMITH_API_KEY=...
# LANGSMITH_TRACING=true
